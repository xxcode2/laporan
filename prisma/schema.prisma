generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model Order {
  id              String   @id @default(cuid())
  date            DateTime
  customer_name   String
  items_count     Int
  item_prices     String
  total_price     Int
  dp_amount       Int
  dp_method       String
  modal           Int
  status          String
  note            String?
  checkout_date   DateTime?
  checkout_amount Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
